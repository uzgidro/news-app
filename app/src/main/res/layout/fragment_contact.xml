<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/contacts_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contactScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <!-- Email -->
            <LinearLayout
                android:id="@+id/emailRow"
                style="@style/ContactRow">

                <ImageView
                    style="@style/ContactRowIcon"
                    android:src="@drawable/ic_email"
                    android:contentDescription="@string/contacts_email_label" />

                <LinearLayout style="@style/ContactRowText">

                    <TextView
                        style="@style/ContactRowLabel"
                        android:text="@string/contacts_email_label" />

                    <TextView
                        style="@style/ContactRowValue"
                        android:text="@string/contacts_email" />
                </LinearLayout>
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:id="@+id/phoneRow"
                style="@style/ContactRow">

                <ImageView
                    style="@style/ContactRowIcon"
                    android:src="@drawable/ic_phone"
                    android:contentDescription="@string/contacts_phone_label" />

                <LinearLayout style="@style/ContactRowText">

                    <TextView
                        style="@style/ContactRowLabel"
                        android:text="@string/contacts_phone_label" />

                    <TextView
                        style="@style/ContactRowValue"
                        android:text="@string/contacts_phone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Website -->
            <LinearLayout
                android:id="@+id/websiteRow"
                style="@style/ContactRow">

                <ImageView
                    style="@style/ContactRowIcon"
                    android:src="@drawable/ic_web"
                    android:contentDescription="@string/contacts_website_label" />

                <LinearLayout style="@style/ContactRowText">

                    <TextView
                        style="@style/ContactRowLabel"
                        android:text="@string/contacts_website_label" />

                    <TextView
                        style="@style/ContactRowValue"
                        android:text="@string/contacts_website" />
                </LinearLayout>
            </LinearLayout>

            <!-- Address -->
            <LinearLayout
                android:id="@+id/addressRow"
                style="@style/ContactRow">

                <ImageView
                    style="@style/ContactRowIcon"
                    android:src="@drawable/ic_place"
                    android:contentDescription="@string/contacts_address_label" />

                <LinearLayout style="@style/ContactRowText">

                    <TextView
                        style="@style/ContactRowLabel"
                        android:text="@string/contacts_address_label" />

                    <TextView
                        style="@style/ContactRowValue"
                        android:text="@string/contacts_address" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
