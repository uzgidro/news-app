<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="uz.uzgidro.ugenews.presentation.fragment.HomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_home_to_news"
            app:destination="@id/newsFragment" />
        <action
            android:id="@+id/action_home_to_contact"
            app:destination="@id/contactFragment" />
    </fragment>

    <fragment
        android:id="@+id/contactFragment"
        android:name="uz.uzgidro.ugenews.presentation.fragment.ContactFragment"
        android:label="@string/contacts_title" />

    <fragment
        android:id="@+id/newsFragment"
        android:name="uz.uzgidro.ugenews.presentation.fragment.NewsFragment"
        android:label="@string/app_name">
        <argument
            android:name="newsId"
            app:argType="integer" />
    </fragment>

</navigation>
